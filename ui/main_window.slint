// ============================================================
// WINDOWS BRIDGE MAIN INTERFACE
// Dual-Mode Slint Window (Compact Floating Companion vs Modern 3-Column Command Center)
// ============================================================

import { Button } from "std-widgets.slint";
import { ArcReactorOrb } from "components/arc_reactor.slint";
import { QuantumCore } from "components/quantum_core.slint";
import { AudioMeter } from "components/audio_meter.slint";
import { SettingsDialog } from "settings_dialog.slint";
import { OverlayWindow } from "overlay_window.slint";
import { VisionCard } from "components/vision_card.slint";
import { AutomationCard } from "components/automation_card.slint";
import { TranscriptCard } from "components/transcript_card.slint";
import { TelemetryCard } from "components/telemetry_card.slint";
import { HotkeysCard } from "components/hotkeys_card.slint";
import { ColSplitter, RowSplitter } from "components/splitter.slint";

export { OverlayWindow }

export component MainWindow inherits Window {
    title: "N.E.X.A Windows Bridge";
    icon: @image-url("../assets/icon.png");
    full-screen: root.is_fullscreen;
    min-width: 360px;
    min-height: 220px;
    preferred-width: root.is_fullscreen ? 1920px : 380px;
    preferred-height: root.is_fullscreen ? 1080px : 250px;
    background: #080B10;
    default-font-family: "Segoe UI";

    // Dual-Mode State properties
    in-out property <bool> is_fullscreen: false;
    in-out property <bool> is_mic_muted: false;
    in-out property <bool> is_screen_sharing: false;
    in-out property <string> connection_status: "offline"; // "connected" | "connecting" | "offline"
    in-out property <string> avatar_state: "offline";       // "idle" | "listening" | "transmitting_audio" | "thinking" | "speaking" | "barge_in" | "screen_sharing" | "tool_executing" | "connecting" | "offline"
    in-out property <float> pulse_scale: 1.0;
    in-out property <float> volume_level: 0.0;             // Real-time audio RMS volume level (0.0 to 1.0)
    in-out property <string> status_message: "Ready to connect to N.E.X.A Server";
    in-out property <bool> show_settings: false;

    // Computed property: true if explicitly fullscreen or window is maximized/large
    property <bool> is_expanded_view: root.is_fullscreen || root.width > 600px || root.height > 420px;

    // Modular HUD Card Visibility Controls (Customizable via Settings)
    in-out property <bool> show_card_vision: true;
    in-out property <bool> show_card_automation: true;
    in-out property <bool> show_card_transcript: true;
    in-out property <bool> show_card_telemetry: true;
    in-out property <bool> show_card_hotkeys: true;

    // Telemetry properties for Fullscreen HUD
    in-out property <string> telemetry_cpu: "12%";
    in-out property <float> telemetry_cpu_val: 0.12;
    in-out property <string> telemetry_ram: "34%";
    in-out property <float> telemetry_ram_val: 0.34;
    in-out property <string> telemetry_audio: "WASAPI 48kHz (AEC3)";
    in-out property <string> telemetry_ping: "24ms";

    // Live Transcript Properties
    in-out property <string> transcript_user_text: "";
    in-out property <string> transcript_assistant_text: "";

    // Automation Log Stream Properties
    in-out property <string> auto_log_1: "Waiting for AI automation commands...";
    in-out property <string> auto_log_2: "";
    in-out property <string> auto_log_3: "";

    // Config bindings
    in-out property <string> cfg_server_url: "";
    in-out property <string> cfg_auth_token: "";
    in-out property <int> cfg_fps: 1;
    in-out property <bool> cfg_low_ram_mode: true;
    in-out property <bool> cfg_autostart: false;
    in-out property <string> test_status_text: "";
    in-out property <bool> is_testing: false;
    in-out property <string> app_version: "0.1.0";

    // Dynamic HUD Splitter & Layout Properties (Smooth Draggable Panes)
    in-out property <length> split_left_width: 280px;
    in-out property <length> split_right_width: 300px;
    in-out property <length> split_left_h: 240px;
    in-out property <length> split_center_h: 440px;
    in-out property <length> split_right_h: 260px;

    // Callbacks for Rust Orchestration
    callback toggle_connect();
    callback toggle_fullscreen();
    callback toggle_mic_mute();
    callback toggle_screen_share();
    callback open_settings();
    callback save_settings(string, string, int, bool, bool, bool, bool, bool, bool, bool);
    callback test_connection(string, string);

    // Primary Computed Status Text (English Clean AI State)
    property <string> status_text_display:
        root.avatar_state == "listening"          ? "Listening..." :
        root.avatar_state == "transmitting_audio" ? "Transmitting audio..." :
        root.avatar_state == "thinking"           ? "Processing..." :
        root.avatar_state == "speaking"           ? "Speaking..." :
        root.avatar_state == "barge_in"           ? "Barge-in..." :
        (root.avatar_state == "screen_sharing" || root.avatar_state == "transmitting_screen") ? "Transmitting screen..." :
        root.avatar_state == "tool_executing"     ? "Executing command..." :
        (root.avatar_state == "connecting" || root.avatar_state == "reconnecting") ? "Connecting..." :
        root.avatar_state == "idle"               ? "Ready" : "Offline";

    // Top-Level Keyboard Handler (F11 Fullscreen Toggle & Escape Exit Fullscreen)
    FocusScope {
        key-pressed(event) => {
            if (root.show_settings && event.text == Key.Escape) {
                root.show_settings = false;
                accept
            } else if (event.text == Key.F11) {
                root.is_fullscreen = !root.is_fullscreen;
                root.toggle_fullscreen();
                accept
            } else if (event.text == Key.Escape && root.is_fullscreen) {
                root.is_fullscreen = false;
                root.toggle_fullscreen();
                accept
            } else {
                reject
            }
        }

        // ==============================================================
        // MODE 1: COMPACT FLOATING COMPANION (NON-INTRUSIVE MINI WIDGET)
        // ==============================================================
        if !root.is_expanded_view : VerticalLayout {
            padding: 12px;
            spacing: 8px;
            alignment: space-between;

            // 1. Top Header Bar (Integrated Single Bar)
            HorizontalLayout {
                height: 28px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 7px;
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        y: (parent.height - self.height) / 2;
                        background: root.connection_status == "connected" ? #00E5FF :
                                    root.connection_status == "connecting" ? #FF9100 : #546E7A;
                    }
                    Text {
                        text: "N.E.X.A Bridge";
                        font-size: 13px;
                        font-weight: 700;
                        color: #58A6FF;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    Button {
                        text: "⤢ HUD [F11]";
                        clicked => {
                            root.is_fullscreen = true;
                            root.toggle_fullscreen();
                        }
                    }
                    Button {
                        text: "⚙ Settings";
                        clicked => { root.show_settings = !root.show_settings; }
                    }
                }
            }

            // 2. Central Companion Card: Arc Reactor Orb + Speech + Audio Meter
            Rectangle {
                background: #161B22CC;
                border-radius: 8px;
                border-width: 1px;
                border-color: #30363D;
                height: 86px;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    padding-top: 6px;
                    padding-bottom: 6px;
                    spacing: 12px;
                    alignment: center;

                    // Left: Compact 3D Holographic Quantum Neural Core
                    QuantumCore {
                        state: root.avatar_state;
                        level: root.volume_level;
                        pulse_scale: root.pulse_scale;
                        is_screen_sharing: root.is_screen_sharing;
                        orb_size: 58px;
                    }

                    // Right: Status Narrative & Real-time Equalizer
                    VerticalLayout {
                        spacing: 3px;
                        alignment: center;

                        Text {
                            text: root.status_text_display;
                            font-size: 13px;
                            font-weight: 700;
                            color: root.avatar_state == "listening"          ? #00B4D8 :
                                   root.avatar_state == "transmitting_audio" ? #00E5FF :
                                   root.avatar_state == "thinking"           ? #FFB300 :
                                   root.avatar_state == "speaking"           ? #00FF88 :
                                   (root.avatar_state == "screen_sharing" || root.avatar_state == "transmitting_screen") ? #00B0FF :
                                   root.avatar_state == "tool_executing"     ? #7C4DFF :
                                   root.avatar_state == "idle"               ? #00E5FF : #C9D1D9;
                            overflow: elide;
                        }

                        Text {
                            visible: root.status_message != "" && root.status_message != root.status_text_display;
                            text: root.status_message;
                            font-size: 11px;
                            color: #8B949E;
                            overflow: elide;
                        }

                        // Compact 18-bar Fluid Equalizer
                        AudioMeter {
                            volume_level: root.volume_level;
                            is_active: root.avatar_state == "speaking" || root.avatar_state == "listening" || root.avatar_state == "transmitting_audio";
                            theme_color: root.avatar_state == "listening"          ? #00B4D8 :
                                         root.avatar_state == "transmitting_audio" ? #00E5FF :
                                         root.avatar_state == "speaking"           ? #00FF88 :
                                         root.avatar_state == "thinking"           ? #FFB300 :
                                         root.avatar_state == "idle"               ? #00E5FF : #546E7A;
                            bar_count: 18;
                            bar_width: 3px;
                            bar_spacing: 2px;
                            max_bar_height: 16px;
                        }
                    }
                }
            }

            // 3. Hardware Indicators Pill Row
            HorizontalLayout {
                height: 18px;
                spacing: 12px;
                alignment: center;

                // Audio Pill
                HorizontalLayout {
                    spacing: 4px;
                    Rectangle {
                        width: 6px;
                        height: 6px;
                        border-radius: 3px;
                        y: (parent.height - self.height) / 2;
                        background: root.connection_status == "connected" ? (root.is_mic_muted ? #FF9100 : #3FB950) : #8B949E;
                    }
                    Text {
                        text: root.connection_status == "connected" ? (root.is_mic_muted ? "Muted" : "WASAPI 48k") : "Offline";
                        font-size: 10px;
                        color: #8B949E;
                        vertical-alignment: center;
                    }
                }

                // Echo Canceller Pill
                HorizontalLayout {
                    spacing: 4px;
                    Rectangle {
                        width: 6px;
                        height: 6px;
                        border-radius: 3px;
                        y: (parent.height - self.height) / 2;
                        background: root.connection_status == "connected" ? #3FB950 : #8B949E;
                    }
                    Text {
                        text: root.connection_status == "connected" ? "AEC3 Aktif" : "Standby";
                        font-size: 10px;
                        color: #8B949E;
                        vertical-alignment: center;
                    }
                }

                // Vision Pill
                HorizontalLayout {
                    spacing: 4px;
                    Rectangle {
                        width: 6px;
                        height: 6px;
                        border-radius: 3px;
                        y: (parent.height - self.height) / 2;
                        background: root.is_screen_sharing ? #00E5FF : (root.connection_status == "connected" ? #3FB950 : #8B949E);
                    }
                    Text {
                        text: root.is_screen_sharing ? "1 FPS Live" : "D3D11 Ready";
                        font-size: 10px;
                        color: #8B949E;
                        vertical-alignment: center;
                    }
                }
            }

            // 4. Quick Control Action Bar (Touch-friendly 38px height)
            HorizontalLayout {
                height: 38px;
                spacing: 8px;
                Button {
                    text: root.is_mic_muted ? "Unmute" : "Mute";
                    clicked => {
                        root.is_mic_muted = !root.is_mic_muted;
                        root.toggle_mic_mute();
                    }
                }
                Button {
                    text: root.is_screen_sharing ? "Stop Screen" : "Share Screen";
                    clicked => { root.toggle_screen_share(); }
                }
                Button {
                    text: root.connection_status == "connected" ? "Disconnect" :
                          root.connection_status == "connecting" ? "Cancel" : "Connect";
                    primary: root.connection_status != "connected";
                    clicked => { root.toggle_connect(); }
                }
            }
        }

        // ==============================================================
        // MODE 2: FULL SCREEN (MODERN 3-COLUMN COMMAND CENTER)
        // ==============================================================
        if root.is_expanded_view : VerticalLayout {
            padding: 12px;
            spacing: 8px;

            // 1. Top Window Title & App Identity Bar
            HorizontalLayout {
                height: 36px;
                alignment: space-between;

                // Left: Branding & Status Badge
                HorizontalLayout {
                    spacing: 10px;
                    Rectangle {
                        width: 22px;
                        height: 22px;
                        border-radius: 4px;
                        y: (parent.height - self.height) / 2;
                        background: #00E5FF1A;
                        border-width: 1px;
                        border-color: #00E5FF80;

                        Text {
                            text: "NX";
                            font-size: 11px;
                            font-weight: 700;
                            color: #00E5FF;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: "N.E.X.A WINDOWS BRIDGE v" + root.app_version + " [DIRECTX 11 NATIVE]";
                        font-size: 13px;
                        font-weight: 700;
                        color: #F0F6FC;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        height: 20px;
                        border-radius: 10px;
                        background: #00E5FF14;
                        border-width: 1px;
                        border-color: #00E5FF4D;
                        y: (parent.height - self.height) / 2;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 4px;
                            Rectangle {
                                width: 6px;
                                height: 6px;
                                border-radius: 3px;
                                y: (parent.height - self.height) / 2;
                                background: root.connection_status == "connected" ? #3FB950 : #FF9100;
                            }
                            Text {
                                text: root.connection_status == "connected" ? "LIVE WASAPI 48kHz" : "STANDBY";
                                font-size: 10px;
                                font-weight: 600;
                                color: root.connection_status == "connected" ? #3FB950 : #FF9100;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Right: Controls
                HorizontalLayout {
                    spacing: 8px;
                    Button {
                        text: "⟲ Reset Grid";
                        clicked => {
                            root.split_left_width = 280px;
                            root.split_right_width = 300px;
                            root.split_left_h = 240px;
                            root.split_center_h = 440px;
                            root.split_right_h = 260px;
                        }
                    }
                    Button {
                        text: "⤡ Windowed Mode [F11]";
                        clicked => {
                            root.is_fullscreen = false;
                            root.toggle_fullscreen();
                        }
                    }
                    Button {
                        text: "⚙ Settings";
                        clicked => { root.show_settings = !root.show_settings; }
                    }
                }
            }

            // 2. Main 3-Column Command Center Workspace (Dynamic Flexible Grid)
            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 4px;

                // ── LEFT COLUMN: Vision & Automation ─────────────────
                if root.show_card_vision || root.show_card_automation : VerticalLayout {
                    width: root.split_left_width;
                    spacing: 0px;

                    if root.show_card_vision && root.show_card_automation : VerticalLayout {
                        vertical-stretch: 1;
                        spacing: 0px;

                        VisionCard {
                            height: root.split_left_h;
                            is_streaming: root.is_screen_sharing;
                            toggle_share => { root.toggle_screen_share(); }
                        }

                        RowSplitter {
                            delta_y(dy) => {
                                root.split_left_h = Math.max(120px, Math.min(parent.height - 120px, root.split_left_h + dy));
                            }
                        }

                        AutomationCard {
                            vertical-stretch: 1;
                            log_1: root.auto_log_1;
                            log_2: root.auto_log_2;
                            log_3: root.auto_log_3;
                        }
                    }

                    if root.show_card_vision && !root.show_card_automation : VisionCard {
                        vertical-stretch: 1;
                        is_streaming: root.is_screen_sharing;
                        toggle_share => { root.toggle_screen_share(); }
                    }

                    if !root.show_card_vision && root.show_card_automation : AutomationCard {
                        vertical-stretch: 1;
                        log_1: root.auto_log_1;
                        log_2: root.auto_log_2;
                        log_3: root.auto_log_3;
                    }
                }

                // ── LEFT COLUMN SPLITTER ─────────────────────────────
                if root.show_card_vision || root.show_card_automation : ColSplitter {
                    delta_x(dx) => {
                        root.split_left_width = Math.max(200px, Math.min(root.width * 0.45, root.split_left_width + dx));
                    }
                }

                // ── CENTER COLUMN: Arc Reactor Orb & Transcript ───────
                VerticalLayout {
                    horizontal-stretch: 1;
                    min-width: 320px;
                    spacing: 0px;

                    if root.show_card_transcript : VerticalLayout {
                        vertical-stretch: 1;
                        spacing: 0px;

                        // Centerpiece Box: Orb + Equalizer + Status
                        Rectangle {
                            height: root.split_center_h;
                            background: #0B101AE6;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: #30363D;

                            VerticalLayout {
                                padding: 14px;
                                spacing: 8px;
                                alignment: center;

                                HorizontalLayout {
                                    alignment: center;
                                    QuantumCore {
                                        state: root.avatar_state;
                                        level: root.volume_level;
                                        pulse_scale: root.pulse_scale;
                                        is_screen_sharing: root.is_screen_sharing;
                                        orb_size: Math.min(220px, Math.max(130px, root.split_center_h * 0.40));
                                    }
                                }

                                // Wide Audio Frequency Spectrum
                                AudioMeter {
                                    volume_level: root.volume_level;
                                    is_active: root.avatar_state == "speaking" || root.avatar_state == "listening" || root.avatar_state == "transmitting_audio";
                                    theme_color: root.avatar_state == "listening"          ? #00B4D8 :
                                                 root.avatar_state == "transmitting_audio" ? #00E5FF :
                                                 root.avatar_state == "speaking"           ? #00FF88 :
                                                 root.avatar_state == "thinking"           ? #FFB300 :
                                                 root.avatar_state == "idle"               ? #00E5FF : #546E7A;
                                    bar_count: 36;
                                    bar_width: 4px;
                                    bar_spacing: 3px;
                                    max_bar_height: 28px;
                                }

                                Text {
                                    horizontal-alignment: center;
                                    text: root.status_text_display;
                                    font-size: 18px;
                                    font-weight: 700;
                                    color: root.avatar_state == "listening"          ? #00B4D8 :
                                           root.avatar_state == "transmitting_audio" ? #00E5FF :
                                           root.avatar_state == "thinking"           ? #FFB300 :
                                           root.avatar_state == "speaking"           ? #00FF88 :
                                           (root.avatar_state == "screen_sharing" || root.avatar_state == "transmitting_screen") ? #00B0FF :
                                           root.avatar_state == "tool_executing"     ? #7C4DFF :
                                           root.avatar_state == "idle"               ? #00E5FF : #C9D1D9;
                                }

                                Text {
                                    visible: root.status_message != "" && root.status_message != root.status_text_display;
                                    horizontal-alignment: center;
                                    text: root.status_message;
                                    font-size: 11px;
                                    color: #8B949E;
                                }
                            }
                        }

                        RowSplitter {
                            delta_y(dy) => {
                                root.split_center_h = Math.max(220px, Math.min(parent.height - 140px, root.split_center_h + dy));
                            }
                        }

                        TranscriptCard {
                            vertical-stretch: 1;
                            user_text: root.transcript_user_text;
                            assistant_text: root.transcript_assistant_text;
                        }
                    }

                    if !root.show_card_transcript : Rectangle {
                        vertical-stretch: 1;
                        background: #0B101AE6;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #30363D;

                        VerticalLayout {
                            padding: 24px;
                            spacing: 14px;
                            alignment: center;

                            HorizontalLayout {
                                alignment: center;
                                QuantumCore {
                                    state: root.avatar_state;
                                    level: root.volume_level;
                                    pulse_scale: root.pulse_scale;
                                    is_screen_sharing: root.is_screen_sharing;
                                    orb_size: 240px;
                                }
                            }

                            AudioMeter {
                                volume_level: root.volume_level;
                                is_active: root.avatar_state == "speaking" || root.avatar_state == "listening" || root.avatar_state == "transmitting_audio";
                                theme_color: root.avatar_state == "listening"          ? #00B4D8 :
                                             root.avatar_state == "transmitting_audio" ? #00E5FF :
                                             root.avatar_state == "speaking"           ? #00FF88 :
                                             root.avatar_state == "thinking"           ? #FFB300 :
                                             root.avatar_state == "idle"               ? #00E5FF : #546E7A;
                                bar_count: 44;
                                bar_width: 4px;
                                bar_spacing: 3px;
                                max_bar_height: 36px;
                            }

                            Text {
                                horizontal-alignment: center;
                                text: root.status_text_display;
                                font-size: 22px;
                                font-weight: 700;
                                color: root.avatar_state == "listening"          ? #00B4D8 :
                                       root.avatar_state == "transmitting_audio" ? #00E5FF :
                                       root.avatar_state == "thinking"           ? #FFB300 :
                                       root.avatar_state == "speaking"           ? #00FF88 :
                                       (root.avatar_state == "screen_sharing" || root.avatar_state == "transmitting_screen") ? #00B0FF :
                                       root.avatar_state == "tool_executing"     ? #7C4DFF :
                                       root.avatar_state == "idle"               ? #00E5FF : #C9D1D9;
                            }

                            Text {
                                horizontal-alignment: center;
                                text: root.status_message;
                                font-size: 13px;
                                color: #8B949E;
                            }
                        }
                    }
                }

                // ── RIGHT COLUMN SPLITTER ────────────────────────────
                if root.show_card_telemetry || root.show_card_hotkeys : ColSplitter {
                    delta_x(dx) => {
                        root.split_right_width = Math.max(220px, Math.min(root.width * 0.45, root.split_right_width - dx));
                    }
                }

                // ── RIGHT COLUMN: Telemetry, Hotkeys & Action Dock ───
                if root.show_card_telemetry || root.show_card_hotkeys : VerticalLayout {
                    width: root.split_right_width;
                    spacing: 8px;

                    if root.show_card_telemetry && root.show_card_hotkeys : VerticalLayout {
                        vertical-stretch: 1;
                        spacing: 0px;

                        TelemetryCard {
                            height: root.split_right_h;
                            cpu_text: root.telemetry_cpu;
                            cpu_val: root.telemetry_cpu_val;
                            ram_text: root.telemetry_ram;
                            ram_val: root.telemetry_ram_val;
                            ping_text: root.telemetry_ping;
                            wasapi_text: root.telemetry_audio;
                        }

                        RowSplitter {
                            delta_y(dy) => {
                                root.split_right_h = Math.max(160px, Math.min(parent.height - 180px, root.split_right_h + dy));
                            }
                        }

                        HotkeysCard {
                            vertical-stretch: 1;
                        }
                    }

                    if root.show_card_telemetry && !root.show_card_hotkeys : TelemetryCard {
                        vertical-stretch: 1;
                        cpu_text: root.telemetry_cpu;
                        cpu_val: root.telemetry_cpu_val;
                        ram_text: root.telemetry_ram;
                        ram_val: root.telemetry_ram_val;
                        ping_text: root.telemetry_ping;
                        wasapi_text: root.telemetry_audio;
                    }

                    if !root.show_card_telemetry && root.show_card_hotkeys : HotkeysCard {
                        vertical-stretch: 1;
                    }

                    // Action Controls Card (Fixed 52px height at bottom of right column)
                    Rectangle {
                        background: #0B101AE6;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #30363D;
                        height: 52px;

                        HorizontalLayout {
                            padding: 8px;
                            spacing: 8px;

                            Button {
                                text: root.is_mic_muted ? "🔇 Unmute" : "🎙️ Mute";
                                clicked => {
                                    root.is_mic_muted = !root.is_mic_muted;
                                    root.toggle_mic_mute();
                                }
                            }
                            Button {
                                text: root.is_screen_sharing ? "⏹️ Stop Screen" : "👁️ Share Screen";
                                clicked => { root.toggle_screen_share(); }
                            }
                            Button {
                                text: root.connection_status == "connected" ? "Disconnect" : "Connect";
                                primary: root.connection_status != "connected";
                                clicked => { root.toggle_connect(); }
                            }
                        }
                    }
                }
            }

            // 3. Bottom App Shell Diagnostic Status Bar
            HorizontalLayout {
                height: 22px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 8px;
                    Text {
                        text: "● Backend: Rust + Slint Native | AEC3: Active | Display: DXGI D3D11";
                        font-size: 10px;
                        color: #8B949E;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: "Device: Lenovo ThinkPad X380 Yoga | Mode: Command Center";
                    font-size: 10px;
                    color: #58A6FF;
                    vertical-alignment: center;
                }
            }
        }
    }

    // Modal Settings Overlay
    if root.show_settings : Rectangle {
        width: 100%;
        height: 100%;
        background: #000000CC;

        SettingsDialog {
            width: min(560px, parent.width - 32px);
            height: min(520px, parent.height - 32px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            server_url: root.cfg_server_url;
            auth_token: root.cfg_auth_token;
            capture_fps: root.cfg_fps;
            low_ram_mode: root.cfg_low_ram_mode;
            autostart: root.cfg_autostart;
            show_card_vision: root.show_card_vision;
            show_card_automation: root.show_card_automation;
            show_card_transcript: root.show_card_transcript;
            show_card_telemetry: root.show_card_telemetry;
            show_card_hotkeys: root.show_card_hotkeys;
            test_status_text: root.test_status_text;
            is_testing: root.is_testing;

            save_clicked(url, token, fps, low_ram, autostart, vision, auto, trans, telem, hotkeys) => {
                root.cfg_server_url = url;
                root.cfg_auth_token = token;
                root.cfg_fps = fps;
                root.cfg_low_ram_mode = low_ram;
                root.cfg_autostart = autostart;
                root.show_card_vision = vision;
                root.show_card_automation = auto;
                root.show_card_transcript = trans;
                root.show_card_telemetry = telem;
                root.show_card_hotkeys = hotkeys;
                root.save_settings(url, token, fps, low_ram, autostart, vision, auto, trans, telem, hotkeys);
                root.show_settings = false;
            }
            test_connection_clicked(url, token) => {
                root.test_connection(url, token);
            }
            close_clicked => {
                root.show_settings = false;
            }
        }
    }
}
